# Copy to /etc/fcsc-mcp.env on the server (chmod 600). Never commit real values.

PORT=3000
HOST=127.0.0.1

# Restrict once the calling client is known, e.g. https://claude.ai
CORS_ORIGIN=*

# Override the FCSC API base URL (testing/stubs only)
# FCSC_BASE_URL=https://releaseeuaestat.fcsc.gov.ae/rest

# Sent as Ocp-Apim-Subscription-Key, if and when FCSC issue a key
# FCSC_API_KEY=
